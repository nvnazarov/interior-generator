{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // ESM compatibility.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true
    // "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.ts"],
  "exclude": ["dist"]
}
